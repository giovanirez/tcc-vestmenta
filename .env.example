# Copie este arquivo para ".env" (sem o .example) e preencha com os
# dados de verdade. O ".env" nunca é commitado (está no .gitignore) —
# cada ambiente (seu XAMPP local, o Render/Cloud Run) tem o seu. Em
# produção essas variáveis são definidas no painel do serviço (ou no
# render.yaml), não por arquivo.

# ---- Backend (API) ----
#
# Onde achar no Supabase: botão "Connect" > aba "Direct" > Connection
# Method "Session pooler". Use o pooler, não a "Direct connection":
# o host direto (db.xxx.supabase.co) só responde em IPv6, e nem o
# Render nem o Cloud Run saem por IPv6.
#
# No pooler o usuário leva o id do projeto depois de um ponto:
# <papel>.<id-do-projeto>. A senha é a que você definiu pro
# backend_role em schema-supabase.sql (ou depois com ALTER ROLE).
DB_HOST=aws-0-sa-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=backend_role.xxxxxxxxxxxxxxxxxxxx
DB_PASSWORD=

# Gere com: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=

# Origem do front-end autorizada a chamar a API (CORS). Aceita só o
# domínio (o https:// é completado). Localmente, no XAMPP, front e API
# ficam na mesma origem e isso nem é consultado.
FRONTEND_ORIGIN=http://localhost

# ---- Front-end ----
#
# URL da API. Só precisa em produção, onde front e API são serviços
# separados (ex.: modasys-api.onrender.com). Sem ela, o front usa o
# caminho local backend/public/index.php.
# API_URL=
