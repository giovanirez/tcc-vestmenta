# Copie este arquivo para ".env" (sem o .example) e preencha com os
# dados de verdade. O ".env" nunca é commitado (está no .gitignore) —
# cada ambiente (seu XAMPP local, o Cloud Run) tem o seu.
#
# Onde achar isso no Supabase: botão "Connect" no topo do painel >
# aba "Direct connection". Host, porta e nome do banco vêm de lá;
# usuário e senha são os que você criou pro backend_role em
# schema-supabase.sql (ou definiu depois com ALTER ROLE).

DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=backend_role
DB_PASSWORD=

# Gere com: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=

# Origem permitida a chamar a API (CORS).
FRONTEND_ORIGIN=http://localhost:8000
